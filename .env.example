# Copy this file to .env and fill in your actual values. .env is loaded
# automatically by src/landtitle/config.py (via python-dotenv) — no need to
# export these in your shell.

# Required — no default, QwenClient raises immediately if this is unset.
# Bare origin only, no trailing /v1 (the client appends /v1/chat/completions
# itself). Ngrok free-tier URLs change every time the Kaggle session restarts.
LLM_API_BASE_URL=https://outflank-filler-bullwhip.ngrok-free.dev

# Optional — only sent as an Authorization: Bearer header if set. Leave unset
# if your FastAPI server doesn't check for one.
# LLM_API_KEY=

# Optional — request timeout in seconds. Defaults to 120.
# LLM_API_TIMEOUT=120
